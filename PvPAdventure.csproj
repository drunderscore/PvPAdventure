<Project Sdk="Tomat.Terraria.ModLoader.Sdk/2.1.1">

	<PropertyGroup>
		<TmlVersion>steam</TmlVersion>
		<Nullable>disable</Nullable>
		<AssemblyName>PvPAdventure</AssemblyName>
		<LangVersion>latest</LangVersion>
		<!-- tModLoader dependency packaging writes shared files and cannot run concurrently. -->
		<BuildInParallel>false</BuildInParallel>
		<NoWarn>$(NoWarn);CS0436</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\PvPFramework\PvPFramework.csproj" />
		<ProjectReference Include="..\PvPHub\PvPHub.csproj" />
	</ItemGroup>

	<!-- tml-build supplies Krafs.Publicizer and publicizes tModLoader by default. -->
</Project>
