
<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\tModLoader.targets" />
	<PropertyGroup>
		<AssemblyName>PvPAdventure</AssemblyName>
		<LangVersion>latest</LangVersion>
		<!-- tModLoader dependency packaging writes shared files and cannot run concurrently. -->
		<BuildInParallel>false</BuildInParallel>
		<NoWarn>$(NoWarn);CS0436</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\PvPOnline\PvPOnline.csproj" />
	</ItemGroup>

	<!-- Makes use of Krafs Publicizer when compiling tModLoader.dll, making all access modifiers public -->
	<ItemGroup>
	<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	</PackageReference>

	<Publicize Include="tModLoader"
			   IncludeVirtualMembers="false"
			   IncludeCompilerGeneratedMembers="false" />
</ItemGroup>
</Project>
